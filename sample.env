# Security - change these in production!
FLASK_DEBUG=false
FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-value
ADMIN_BOOTSTRAP_PASSWORD=change-me-first-boot
FLASK_CSRF=true
FLASK_SECURE_COOKIES=true

# Makespace SSO (OIDC). Keep the confidential client secret server-side.
OIDC_ISSUER=https://identity.mksmad.org/realms/Makespace
OIDC_DISCOVERY_URL=https://identity.mksmad.org/realms/Makespace/.well-known/openid-configuration
OIDC_CLIENT_ID=manavote
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://manavote.mksmad.org/auth/callback/keycloak
OIDC_POST_LOGOUT_REDIRECT_URI=https://manavote.mksmad.org/login
OIDC_REQUIRED_GROUP=members-active

# Telegram Bot Configuration (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
TELEGRAM_ADMIN_ID=
TELEGRAM_WEBHOOK_SECRET=change-me-soon
# Linked Telegram accounts are allowed automatically. Add supplemental user IDs here.
# Keep this restricted: MCP has admin powers.
TELEGRAM_MCP_URL=http://127.0.0.1:8765/mcp
TELEGRAM_MCP_ALLOWED_USER_IDS=
TELEGRAM_MCP_ALLOW_GROUPS=false
# Optional OpenAI-compatible LLM: linked users can then talk to the bot naturally.
TELEGRAM_LLM_API_KEY=
TELEGRAM_LLM_MODEL=
TELEGRAM_LLM_BASE_URL=https://api.openai.com/v1
TELEGRAM_LLM_SYSTEM_PROMPT=
TELEGRAM_LLM_HISTORY_TTL=1800
TELEGRAM_LLM_WORKERS=2
# After first boot, set the public Base URL in Admin > Telegram Configuration.
# The webhook is synchronized automatically on each application startup.

# Admin API Key (required for /api/* endpoints)
ADMIN_API_KEY=change-me-soon

# MCP admin server
MCP_API_KEY=change-me-soon
MCP_SERVER_ENABLED=false
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765
